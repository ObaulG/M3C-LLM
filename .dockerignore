# Ignorer les fichiers de développement et données
.venv/
.idea/
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignorer les fichiers de données locaux
*.csv
*.xlsx
*.ods
*.json
*.pdf

# Ignorer les fichiers de configuration locaux
.env
.env.local
.env.*
!.env.example

# Ignorer les fichiers de logs et temporaires
*.log
*.tmp
*.swp

# Ignorer les fichiers Git
.git/
.gitignore
.gitattributes

# Ignorer les fichiers de documentation
README.md

# Ignorer les exports et données
exports/
