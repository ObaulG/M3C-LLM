{% extends "base.html" %}
{% block title %}Gestion des Questions/Réponses{% endblock %}

{% block head_scripts %}
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<link rel="stylesheet" href="{{ static_prefix }}questions.css" />
<link rel="stylesheet" href="{{ static_prefix }}admin/admin.css" />
<script src="{{ static_prefix }}models.js"></script>
{% endblock %}

{% block styles %}
<style>
    /* Styles spécifiques pour la gestion des questions */
    .filters-section {
        padding: 20px;
        background: #f8f9fa;
        border-bottom: 1px solid #e0e0e0;
    }

    .filter-group {
        margin-bottom: 15px;
    }

    .filter-group label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
        font-size: 14px;
    }

    .filter-group select,
    .filter-group input {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid #e0e0e0;
        border-radius: 5px;
        font-size: 14px;
    }

    .document-selector {
        margin-bottom: 20px;
    }

    /* Styles pour l'édition des questions */
    .editable-question-text,
    .editable-answer-text {
        width: 100%;
        min-height: 80px;
        padding: 10px;
        border: 2px solid #ddd;
        border-radius: 5px;
        font-family: inherit;
        font-size: 14px;
        resize: vertical;
        margin: 5px 0;
    }

    .editable-question-text:focus,
    .editable-answer-text:focus {
        border-color: #b74420;
        outline: none;
    }

    .answer-item.editing {
        margin-top: 10px;
        padding: 10px;
        background-color: #f8f9fa;
        border-radius: 5px;
        border: 1px solid #e0e0e0;
    }

    .answer-item.editing.new-answer-item {
        border: 1px dashed #ccc;
    }

    .btn-edit-question {
        background: #007bff;
        margin-right: 10px;
    }

    .btn-save-changes {
        background: #28a745;
    }

    .btn-cancel-edit {
        background: #6c757d;
    }

    .btn-delete-answer {
        padding: 2px 8px;
        font-size: 12px;
    }

    .edit-mode {
        border-left: 4px solid #b74420;
        background-color: #fff8f8;
    }

    .edit-actions {
        margin-top: 15px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }
</style>
{% endblock %}

{% block body %}
<div class="main_container">
    <div class="sidebar">
        <h3>Documents</h3>
        <div class="document-selector">
            <div class="loading" id="loadingDocuments">
                <div class="spinner"></div>
                <p>Chargement des documents...</p>
            </div>
            <ul class="document-list" id="documentList">
                <!-- Les documents seront chargés dynamiquement -->
            </ul>
        </div>
        
        <div class="filters-section">
            <h4>Filtres</h4>
            
            <div class="filter-group">
                <label for="statusFilter">Statut</label>
                <select id="statusFilter">
                    <option value="">Tous</option>
                    <option value="generated">Généré</option>
                    <option value="validated">Validé</option>
                    <option value="pending">En attente</option>
                </select>
            </div>

            <div class="filter-group">
                <label for="difficultyFilter">Difficulté</label>
                <select id="difficultyFilter">
                    <option value="">Toutes</option>
                    <option value="1">1 - Très facile</option>
                    <option value="2">2 - Facile</option>
                    <option value="3">3 - Moyenne</option>
                    <option value="4">4 - Difficile</option>
                    <option value="5">5 - Très difficile</option>
                </select>
            </div>

            <div class="filter-group">
                <label for="limitFilter">Nombre de résultats</label>
                <input type="number" id="limitFilter" min="1" max="100" placeholder="Toutes">
            </div>

            <div class="filter-group">
                <label for="chunkFilter">Numéro de chunk</label>
                <input type="text" id="chunkFilter" placeholder="Ex: 1, 2, 123">
            </div>

            <div class="filter-group">
                <label for="modelFilter">Modèle LLM pour l'évaluation</label>
                <select id="modelFilter"><option value="">Modèle par défaut (mistral-small)</option></select>
            </div>

            <button class="btn" onclick="applyFilters()">Appliquer les filtres</button>
            <button class="btn btn-secondary" onclick="resetFilters()" style="margin-top: 10px;">Réinitialiser</button>
        </div>
    </div>

    <div class="content-area">
        {{ header_centered(
            title='📝 Gestion des Questions/Réponses',
            subtitle='Sélectionnez un document pour visualiser ses questions générées',
            page='questions_management.html',
            page_dir='root',
            show_admin=true
        ) }}

        <div class="questions-container">
            <div class="loading" id="loadingQuestions">
                <div class="spinner"></div>
                <p>Chargement des questions...</p>
            </div>
            
            <div id="questionsContent">
                <!-- Les questions seront affichées ici -->
                <div class="empty-state" id="emptyState">
                    <h3>Aucun document sélectionné</h3>
                    <p>Sélectionnez un document dans la barre latérale pour afficher ses questions.</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    // Données des réponses de référence chargées au démarrage
    let referenceAnswers = {};
    
    // Charge les réponses de référence au démarrage
    async function loadReferenceAnswers() {
        try {
            console.log('Chargement des réponses de référence depuis /api/reference-answers...');
            const response = await fetch('/api/reference-answers');
            if (response.ok) {
                const data = await response.json();
                referenceAnswers = data.reference_answers || {};
                console.log('✓ Réponses de référence chargées:', Object.keys(referenceAnswers).length, 'questions');
                console.log('IDs des questions avec référence:', Object.keys(referenceAnswers));
            } else {
                console.warn('Aucune réponse de référence trouvée, mais cela est normal si le fichier CSV est vide');
            }
        } catch (error) {
            console.error('Erreur lors du chargement des réponses de référence:', error);
        }
    }
    
    // Appel au chargement de la page
    document.addEventListener('DOMContentLoaded', function() {
        loadReferenceAnswers();
    });
</script>
<script src="{{ static_prefix }}questions_management.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    loadModelsIntoSelect(document.getElementById("modelFilter"), { prefixProvider: true, keepFirst: true });
  });
</script>
{% endblock %}
