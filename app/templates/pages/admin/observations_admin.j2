{% extends "base.html" %}
{% block title %}Administration - Observations manuelles{% endblock %}
{% block styles %}
<style>
        .main_container { display: flex; height: 100vh; width: 100%; }
        .sidebar { width: 300px; background: white; border-right: 1px solid #ddd; padding: 20px; overflow-y: auto; display: flex; flex-direction: column; }
        .content-area { flex: 1; display: flex; flex-direction: column; overflow-y: auto; }
        .header { background: linear-gradient(135deg, #b74420 0%, #d16b3f 100%); color: white; padding: 20px; text-align: center; }
        .header h1 { font-size: 24px; margin-bottom: 5px; }
        .header p { opacity: 0.9; font-size: 14px; }
        .nav-links { display: flex; justify-content: center; gap: 20px; margin-top: 10px; flex-wrap: wrap; }
        .nav-link { color: white; text-decoration: none; padding: 5px 10px; border-radius: 5px; font-size: 14px; }
        .nav-link:hover { background: rgba(255, 255, 255, 0.2); }
        .nav-link.active { background: rgba(255, 255, 255, 0.3); }
        .admin-content { padding: 20px; flex: 1; overflow-y: auto; }
        .section-title { font-size: 20px; color: #333; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 2px solid #e0e0e0; }
        .form-section { background: white; border: 1px solid #e0e0e0; border-radius: 8px; padding: 25px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; margin-bottom: 8px; font-weight: 600; color: #495057; font-size: 14px; }
        .form-group .description { font-size: 12px; color: #888; margin-top: 4px; }
        .form-group select, .form-group input, .form-group textarea { width: 100%; padding: 10px 12px; border: 1px solid #e0e0e0; border-radius: 6px; font-size: 14px; box-sizing: border-box; }
        .form-group select:focus, .form-group input:focus, .form-group textarea:focus { outline: none; border-color: #b74420; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        @media (max-width: 900px) { .form-row { grid-template-columns: 1fr; } }
        .btn { padding: 12px 24px; background: linear-gradient(135deg, #b74420 0%, #d16b3f 100%); color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; font-weight: bold; transition: opacity 0.2s; }
        .btn:hover { opacity: 0.9; }
        .btn:disabled { opacity: 0.6; cursor: not-allowed; }
        .btn-secondary { background: #6c757d; }
        .targets-editor { border: 1px solid #e0e0e0; border-radius: 8px; padding: 15px; }
        .target-row { display: grid; grid-template-columns: 130px 1fr 90px auto; gap: 10px; margin-bottom: 10px; align-items: center; }
        .target-row select, .target-row input { padding: 8px 10px; border: 1px solid #e0e0e0; border-radius: 6px; font-size: 13px; width: 100%; box-sizing: border-box; }
        .target-remove { background: #f8d7da; color: #721c24; border: none; border-radius: 6px; padding: 8px 12px; cursor: pointer; font-weight: bold; }
        .target-add { background: #e7f3ff; color: #1976D2; border: 1px solid #bbdefb; border-radius: 6px; padding: 8px 14px; cursor: pointer; font-size: 13px; }
        .observations-table-wrapper { background: white; border: 1px solid #e0e0e0; border-radius: 8px; overflow-x: auto; }
        .observations-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .observations-table th { background: #f8f9fa; padding: 12px; text-align: left; font-size: 12px; text-transform: uppercase; color: #666; border-bottom: 2px solid #e0e0e0; white-space: nowrap; }
        .observations-table td { padding: 12px; border-bottom: 1px solid #f0f0f0; vertical-align: top; }
        .observations-table tr:hover td { background: #fafafa; }
        .badge { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 11px; font-weight: 600; margin: 1px; }
        .badge-declarative { background: #e3f2fd; color: #1565c0; }
        .badge-behavioral { background: #e8f5e9; color: #2e7d32; }
        .badge-evaluative { background: #f3e5f5; color: #7b1fa2; }
        .badge-target { background: #fff8e1; color: #b74420; }
        .conf-value { font-weight: bold; color: #b74420; }
        .json-preview { font-family: monospace; font-size: 12px; color: #555; white-space: pre-wrap; word-break: break-word; max-width: 320px; }
        .alert { padding: 12px 16px; border-radius: 6px; margin-bottom: 15px; font-size: 14px; }
        .alert-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .alert-error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
        .loading { display: none; text-align: center; padding: 40px; color: #666; }
        .loading.active { display: block; }
        .spinner { border: 3px solid #f3f3f3; border-top: 3px solid #b74420; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 0 auto 15px; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .empty-state { text-align: center; color: #888; padding: 40px; font-size: 14px; }
        .schema-note { background: #e7f3ff; border-left: 4px solid #2196F3; padding: 15px; border-radius: 8px; margin-bottom: 20px; font-size: 13px; color: #444; line-height: 1.7; }
        .schema-note code { background: rgba(255,255,255,0.6); padding: 1px 5px; border-radius: 4px; }
        @media (max-width: 768px) { .main_container { flex-direction: column; } .sidebar { width: 100%; height: auto; } .nav-links { flex-wrap: wrap; justify-content: center; } .target-row { grid-template-columns: 1fr; } }
    </style>
{% endblock %}
{% block body %}

    <div class="main_container">
        <div class="sidebar">
            <h3>Administration</h3>
            <div class="stats-section">
                <div class="stat-card">
                    <div class="label">Observations en base</div>
                    <div class="value" id="observationsCount">-</div>
                </div>
            </div>
            <button class="refresh-btn" onclick="loadObservations()">&#128260; Rafraîchir</button>
        </div>
        <div class="content-area">
            {{ header_centered(title='👁 Administration - Observations manuelles', subtitle='Démonstration : appliquez manuellement des observations d\'éléments de connaissance (schéma user_knowledge_model.sql)', page='/admin/observations', show_admin=true) }}

                <div class="schema-note">
                    Une observation est un événement horodaté, jamais une conclusion : elle est enregistrée dans
                    <code>observations</code>, ses données dans <code>observation_payloads</code> et les éléments
                    de connaissance, thèmes ou entités concernés dans <code>observation_targets</code>.
                    Familles : <b>déclarative</b> (préférences explicites), <b>comportementale</b> (consultation,
                    recherche, clic), <b>évaluative</b> (réponse libre, score).
                </div>

                <h2 class="section-title">Appliquer une observation</h2>
                <div class="form-section">
                    <form id="observationForm" onsubmit="return submitObservation(event)">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="userId">Utilisateur observé</label>
                                <select id="userId" required>
                                    <option value="">-- Chargement... --</option>
                                </select>
                                <div class="description">observations.user_id : compte users ou profil user_profiles</div>
                            </div>
                            <div class="form-group">
                                <label for="observationType">Famille d'observation</label>
                                <select id="observationType" required>
                                    <option value="declarative">Déclarative (préférence, langue, objectif)</option>
                                    <option value="behavioral">Comportementale (consultation, clic, recherche)</option>
                                    <option value="evaluative">Évaluative (réponse libre, score)</option>
                                </select>
                                <div class="description">observations.observation_type</div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="specificType">Type spécifique</label>
                                <input type="text" id="specificType" placeholder="ex: language, click, free_response, reading_time" required />
                                <div class="description">observations.specific_type</div>
                            </div>
                            <div class="form-group">
                                <label for="confidence">Confiance (0 à 1)</label>
                                <input type="number" id="confidence" min="0" max="1" step="0.1" value="1.0" required />
                                <div class="description">observations.confidence : fiabilité de l'interprétation</div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="contextJson">Contexte (JSON)</label>
                            <textarea id="contextJson" rows="3" placeholder='{"page": "m3c-chatbot", "session_id": "demo", "resource_id": 116782, "device": "desktop"}'></textarea>
                            <div class="description">observations.context : session, page, ressource, dispositif</div>
                        </div>
                        <div class="form-group">
                            <label for="payloadJson">Payload (JSON, optionnel)</label>
                            <textarea id="payloadJson" rows="3" placeholder='{"answer": "...", "score": 0.8}'></textarea>
                            <div class="description">observation_payloads.payload : donnée brute ou résultat structuré</div>
                        </div>
                        <div class="form-group">
                            <label>Cibles (connaissances, thèmes, entités concernés)</label>
                            <div class="targets-editor">
                                <div id="targetsContainer"></div>
                                <button type="button" class="target-add" onclick="addTargetRow()">+ Ajouter une cible</button>
                            </div>
                            <div class="description">observation_targets : target_type, target_id, weight</div>
                        </div>
                        <button type="submit" class="btn" id="submitBtn">Enregistrer l'observation</button>
                        <button type="button" class="btn btn-secondary" onclick="resetForm()">Réinitialiser</button>
                    </form>
                </div>

                <h2 class="section-title">Observations enregistrées</h2>
                <div class="form-section">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="filterUser">Filtrer par utilisateur</label>
                            <select id="filterUser">
                                <option value="">Tous</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="filterType">Filtrer par famille</label>
                            <select id="filterType">
                                <option value="">Toutes</option>
                                <option value="declarative">Déclaratives</option>
                                <option value="behavioral">Comportementales</option>
                                <option value="evaluative">Évaluatives</option>
                            </select>
                        </div>
                    </div>
                    <button type="button" class="btn" onclick="loadObservations()">Appliquer les filtres</button>
                </div>
                <div class="loading" id="obsLoading">
                    <div class="spinner"></div>
                    <div>Chargement des observations...</div>
                </div>
                <div class="observations-table-wrapper">
                    <table class="observations-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Utilisateur</th>
                                <th>Type</th>
                                <th>Spécifique</th>
                                <th>Horodatage</th>
                                <th>Confiance</th>
                                <th>Cibles</th>
                                <th>Contexte</th>
                                <th>Payload</th>
                            </tr>
                        </thead>
                        <tbody id="observationsBody">
                            <tr><td colspan="9" class="empty-state">Aucune observation chargée.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    
{% endblock %}
{% block scripts %}
<script src="{{ static_prefix }}admin/observations_admin.js"></script>
{% endblock %}