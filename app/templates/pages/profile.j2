{# -*- jinja2 -*- Template pour la page de profil utilisateur -*- #}
{% extends "base.html" %}

{# Import des macros #}
{% from 'macros/header_nav.html' import header %}
{% from 'macros/knowledge_item_card.html' import knowledge_item_card %}
{% from 'macros/theme_stats.html' import theme_stats_card %}
{% from 'macros/resource_card.html' import resource_card %}

{% block title %}{{ page_title|default("Mon Profil - M3C") }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="{{ static_prefix }}css/profile.css" />
<link rel="stylesheet" href="{{ static_prefix }}css/theme_cards.css" />
{% endblock %}

{% block head_scripts %}
<!-- Chart.js pour les futures visualisations (optionnel) -->
<!-- <script src="https://cdn.jsdelivr.net/npm/chart.js"></script> -->
{% endblock %}

{% block body %}
<div class="main_container">
    <div class="container">
        {# En-tête de la page #}
        {{ header(
            title=page_title|default("Mon Profil"),
            subtitle='Statistiques de visite, ressources consultées, thèmes et éléments de connaissance',
            title_icon='👤',
            page='/profile',
            show_admin=false
        ) }}

        <div class="profile-container">
            {# ================================================================
               EN-TÊTE DU PROFIL
               ================================================================ #}
            <div class="profile-header">
                <h1>👤 Mon Profil</h1>
                <p class="subtitle">
                    Bienvenue sur votre espace personnel. Voici l'état de vos observations et connaissances.
                </p>
                
                <div class="profile-user-info">
                    <div class="info-item">
                        <i>📅</i>
                        <span><strong>Inscrit le:</strong> {{ format_date(profile.created_at) }}</span>
                    </div>
                    {% if profile.last_activity_at %}
                    <div class="info-item">
                        <i>🕐</i>
                        <span><strong>Dernière activité:</strong> {{ format_date(profile.last_activity_at) }}</span>
                    </div>
                    {% endif %}
                    {% if profile.visit_goal %}
                    <div class="info-item">
                        <i>🎯</i>
                        <span><strong>Objectif:</strong> {{ profile.visit_goal }}</span>
                    </div>
                    {% endif %}
                    {% if profile.detail_level %}
                    <div class="info-item">
                        <i>📊</i>
                        <span><strong>Niveau:</strong> {{ profile.detail_level }}</span>
                    </div>
                    {% endif %}
                </div>
            </div>

            {# ================================================================
               STATISTIQUES GLOBALES
               ================================================================ #}
            <section class="stats-section">
                <div class="section-header">
                    <span class="icon">📈</span>
                    <h2>Statistiques Globales</h2>
                    <span class="count">{{ stats.total_observations }}</span>
                </div>
                
                <div class="stats-grid">
                    <div class="stat-card">
                        <span class="value">{{ stats.total_observations }}</span>
                        <span class="label">Observations</span>
                    </div>
                    <div class="stat-card">
                        <span class="value">{{ stats.total_resource_views }}</span>
                        <span class="label">Vues ressources</span>
                    </div>
                    <div class="stat-card">
                        <span class="value">{{ stats.total_theme_views }}</span>
                        <span class="label">Vues thèmes</span>
                    </div>
                    <div class="stat-card">
                        <span class="value">{{ stats.total_evaluations }}</span>
                        <span class="label">Évaluations</span>
                    </div>
                    <div class="stat-card">
                        <span class="value">{{ stats.total_resources_visited }}</span>
                        <span class="label">Ressources</span>
                    </div>
                    <div class="stat-card">
                        <span class="value">{{ stats.total_themes_explored }}</span>
                        <span class="label">Thèmes</span>
                    </div>
                </div>

                {# Stats de connaissance #}
                {% if stats.total_knowledge_items_encountered > 0 %}
                <div class="knowledge-stats-row">
                    <div class="knowledge-stat-item">
                        <div class="stat-header">
                            <span class="stat-name">Maîtrisées</span>
                            <span class="stat-pct">{{ knowledge_stats.demonstrated_pct }}%</span>
                        </div>
                        <div class="progress-container">
                            <div class="progress-fill demonstrated" 
                                 style="width: {{ knowledge_stats.demonstrated_pct }}%" 
                                 title="{{ stats.total_knowledge_demonstrated }} connaissances maîtrisées"></div>
                        </div>
                        <span class="stat-count">{{ stats.total_knowledge_demonstrated }} éléments</span>
                    </div>
                    
                    <div class="knowledge-stat-item">
                        <div class="stat-header">
                            <span class="stat-name">En développement</span>
                            <span class="stat-pct">{{ knowledge_stats.developing_pct }}%</span>
                        </div>
                        <div class="progress-container">
                            <div class="progress-fill developing" 
                                 style="width: {{ knowledge_stats.developing_pct }}%" 
                                 title="{{ stats.total_knowledge_developing }} connaissances en développement"></div>
                        </div>
                        <span class="stat-count">{{ stats.total_knowledge_developing }} éléments</span>
                    </div>
                    
                    <div class="knowledge-stat-item">
                        <div class="stat-header">
                            <span class="stat-name">Rencontrées</span>
                            <span class="stat-pct">{{ knowledge_stats.encountered_pct }}%</span>
                        </div>
                        <div class="progress-container">
                            <div class="progress-fill encountered" 
                                 style="width: {{ knowledge_stats.encountered_pct }}%" 
                                 title="{{ stats.total_knowledge_encountered }} connaissances rencontrées"></div>
                        </div>
                        <span class="stat-count">{{ stats.total_knowledge_encountered }} éléments</span>
                    </div>
                    
                    <div class="knowledge-stat-item">
                        <div class="stat-header">
                            <span class="stat-name">Inconnues</span>
                            <span class="stat-pct">{{ knowledge_stats.unknown_pct }}%</span>
                        </div>
                        <div class="progress-container">
                            <div class="progress-fill unknown" 
                                 style="width: {{ knowledge_stats.unknown_pct }}%" 
                                 title="{{ stats.total_knowledge_unknown }} connaissances inconnues"></div>
                        </div>
                        <span class="stat-count">{{ stats.total_knowledge_unknown }} éléments</span>
                    </div>
                </div>
                {% endif %}
            </section>

            {# ================================================================
               OBSERVATIONS
               ================================================================ #}
            <section class="section">
                <div class="section-header">
                    <span class="icon">👁️</span>
                    <h2>Observations</h2>
                    <span class="count">{{ stats.total_observations }}</span>
                </div>

                <p style="color: #666; font-size: 14px; margin-bottom: 20px;">
                    Chaque interaction est enregistrée comme une observation horodatée
                    (déclarative, comportementale ou évaluative), avec son contexte et sa confiance.
                </p>

                {# Compteurs par famille d'observation #}
                <div class="observation-type-cards">
                    {% set type_descriptions = {
                        'declarative': 'Langue, objectif de visite, préférences',
                        'behavioral': 'Consultations, recherches, clics',
                        'evaluative': 'Réponses, scores, évaluations'
                    } %}
                    {% for type_stat in observation_type_stats %}
                    <div class="observation-type-card">
                        <span class="type-name">{{ format_observation_type(type_stat.observation_type) }}</span>
                        <span class="type-count">{{ type_stat.count }}</span>
                        <span class="type-desc">{{ type_descriptions[type_stat.observation_type.value] }}</span>
                        {% if type_stat.last_at %}
                        <span class="type-last">Dernière : {{ format_date(type_stat.last_at) }}</span>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>

                {# Historique récent des observations #}
                {% if recent_observations %}
                <div class="observations-table-wrapper">
                    <table class="observations-table">
                        <thead>
                            <tr>
                                <th>Date / Heure</th>
                                <th>Type</th>
                                <th>Détail</th>
                                <th>Cibles</th>
                                <th>Contexte</th>
                                <th>Confiance</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for obs in recent_observations %}
                            <tr>
                                <td style="white-space: nowrap;">{{ format_date(obs.timestamp) }}</td>
                                <td>
                                    <span class="observation-type-badge type-{{ obs.observation_type.value }}">
                                        {{ format_observation_type(obs.observation_type) }}
                                    </span>
                                    <br>
                                    <span class="observation-specific-type">{{ obs.specific_type }}</span>
                                </td>
                                <td>#{{ obs.observation_id }}</td>
                                <td>
                                    {% if obs.targets %}
                                    <div class="observation-targets">
                                        {% for target in obs.targets %}
                                        <span class="observation-target-tag" title="{{ format_observation_target(target) }}">
                                            {{ format_observation_target(target) }}
                                        </span>
                                        {% endfor %}
                                    </div>
                                    {% else %}
                                    <span style="color: #999;">—</span>
                                    {% endif %}
                                </td>
                                <td class="observation-context">{{ obs.context_display or '—' }}</td>
                                <td class="observation-confidence">{{ format_score(obs.confidence) }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <p style="color: #888; font-size: 12px; margin-top: 8px;">
                    {{ recent_observations|length }} observations les plus récentes affichées sur {{ stats.total_observations }} au total.
                </p>
                {% else %}
                <div class="empty-state">
                    <i>👁️</i>
                    <p>Aucune observation enregistrée pour le moment.</p>
                    <p style="font-size: 14px; margin-top: 10px; color: #888;">
                        Naviguez sur le portail, consultez des ressources et répondez à des évaluations pour générer des observations.
                    </p>
                </div>
                {% endif %}
            </section>

            {# ================================================================
               RESSOURCES CONSULTÉES
               ================================================================ #}
            <section class="section">
                <div class="section-header">
                    <span class="icon">📚</span>
                    <h2>Ressources Consultées</h2>
                    <span class="count">{{ visited_resources|length }}</span>
                </div>
                
                {% if visited_resources %}
                <div class="cards-grid">
                    {% for resource in visited_resources %}
                    {{ resource_card(resource, loop.index0) }}
                    {% endfor %}
                </div>
                {% else %}
                <div class="empty-state">
                    <i>📖</i>
                    <p>Aucune ressource consultée pour le moment.</p>
                    <p style="font-size: 14px; margin-top: 10px; color: #888;">
                        Commencez à explorer les documents pour voir vos visites ici.
                    </p>
                </div>
                {% endif %}
            </section>

            {# ================================================================
               THÈMES EXPLORÉS
               ================================================================ #}
            <section class="section">
                <div class="section-header">
                    <span class="icon">🎯</span>
                    <h2>Thèmes Explorés</h2>
                    <span class="count">{{ theme_stats|length }}</span>
                </div>
                
                {% if theme_stats %}
                <div class="cards-grid">
                    {% for theme in theme_stats %}
                    {{ theme_stats_card(theme, show_details=true, expandable=true) }}
                        {# Afficher les éléments de connaissance pour ce thème #}
                        {% if theme.theme_name in knowledge_by_theme and knowledge_by_theme[theme.theme_name].knowledge_items %}
                            {% for ki in knowledge_by_theme[theme.theme_name].knowledge_items[:5] %}
                                {{ knowledge_item_card(ki, show_details=false, show_sources=false) }}
                            {% endfor %}
                            {% if knowledge_by_theme[theme.theme_name].knowledge_items|length > 5 %}
                            <p style="margin-top: 10px; color: #666; font-size: 13px; text-align: center;">
                                + {{ knowledge_by_theme[theme.theme_name].knowledge_items|length - 5 }} autres connaissances
                            </p>
                            {% endif %}
                        {% else %}
                            <p style="margin-top: 10px; color: #888; font-size: 13px; text-align: center;">
                                Aucune connaissance associée pour le moment
                            </p>
                        {% endif %}
                    {% endfor %}
                </div>
                {% else %}
                <div class="empty-state">
                    <i>🎭</i>
                    <p>Aucun thème exploré pour le moment.</p>
                    <p style="font-size: 14px; margin-top: 10px; color: #888;">
                        Interagissez avec différents sujets pour découvrir vos centres d'intérêt.
                    </p>
                </div>
                {% endif %}
            </section>

            {# ================================================================
               ÉLÉMENTS DE CONNAISSANCE
               ================================================================ #}
            <section class="section">
                <div class="section-header">
                    <span class="icon">💡</span>
                    <h2>Éléments de Connaissance</h2>
                    <span class="count">{{ knowledge_by_theme|length }}</span>
                </div>
                
                {% if knowledge_by_theme %}
                {% for theme_name, theme_group in knowledge_by_theme.items() %}
                <div class="knowledge-theme-section" style="margin-bottom: 30px;">
                    <h3 style="color: #b74420; border-bottom: 1px solid #e0e0e0; padding-bottom: 10px; margin-bottom: 15px;">
                        {{ theme_name }}
                        <span style="background: #b74420; color: white; padding: 2px 8px; border-radius: 10px; font-size: 12px; margin-left: 10px;">
                            {{ theme_group.knowledge_items|length }} éléments
                        </span>
                    </h3>
                    
                    <div class="cards-grid">
                        {% for ki in theme_group.knowledge_items %}
                        {{ knowledge_item_card(ki, show_details=true, show_sources=false) }}
                        {% endfor %}
                    </div>
                </div>
                {% endfor %}
                {% else %}
                <div class="empty-state">
                    <i>💭</i>
                    <p>Aucun élément de connaissance pour le moment.</p>
                    <p style="font-size: 14px; margin-top: 10px; color: #888;">
                        Posez des questions et interagissez avec le système pour commencer à construire votre modèle de connaissances.
                    </p>
                </div>
                {% endif %}
            </section>

            {# ================================================================
               DATE DE PREMIÈRE VISITE
               ================================================================ #}
            {% if stats.first_visit or stats.last_visit %}
            <section class="section" style="border-top: 2px solid #e0e0e0; padding-top: 20px;">
                <div class="section-header">
                    <span class="icon">📅</span>
                    <h2>Historique des Visites</h2>
                </div>
                
                <div class="stats-grid">
                    {% if stats.first_visit %}
                    <div class="stat-card">
                        <span class="value" style="font-size: 24px;">📅</span>
                        <span class="label">Première visite: {{ format_date(stats.first_visit) }}</span>
                    </div>
                    {% endif %}
                    {% if stats.last_visit %}
                    <div class="stat-card">
                        <span class="value" style="font-size: 24px;">🕐</span>
                        <span class="label">Dernière visite: {{ format_date(stats.last_visit) }}</span>
                    </div>
                    {% endif %}
                </div>
            </section>
            {% endif %}

            {# ================================================================
               ACTIONS
               ================================================================ #}
            <div class="action-buttons">
                <a href="/" class="btn btn-secondary">
                    ← Retour à l'accueil
                </a>
                {% if user_id %}
                <a href="/profile/api/{{ user_id }}/export/csv" class="btn btn-primary">
                    📥 Exporter en CSV
                </a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ static_prefix }}js/profile.js"></script>
{% endblock %}
