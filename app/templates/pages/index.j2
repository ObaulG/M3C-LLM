{% extends "base.html" %}
{% block title %}LLMAgents - Portail M3C{% endblock %}

{% block styles %}
<style>
    /* Styles spécifiques pour la page d'accueil */
    .home-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
        width: 100%;
    }

    .home-header {
        text-align: center;
        padding: 30px 0;
        color: white;
    }

    .home-header h1 {
        font-size: 42px;
        margin-bottom: 15px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .home-header p {
        font-size: 18px;
        opacity: 0.95;
        max-width: 800px;
        margin: 0 auto;
    }

    .home-nav {
        background: rgba(255,255,255,0.1);
        padding: 15px 0;
        margin: 20px 0;
        border-radius: 10px;
    }

    .home-nav ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        justify-content: center;
        gap: 30px;
        flex-wrap: wrap;
    }

    .home-nav li a {
        color: white;
        text-decoration: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s ease;
        font-size: 16px;
    }

    .home-nav li a:hover {
        background: rgba(255,255,255,0.2);
        transform: translateY(-2px);
    }

    .project-description {
        line-height: 1.8;
        color: #444;
    }

    .project-description p {
        margin-bottom: 15px;
    }

    .technologies {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
    }

    .tech-tag {
        background: #f0f0f0;
        padding: 8px 15px;
        border-radius: 20px;
        font-size: 14px;
        color: #666;
        border: 1px solid #e0e0e0;
    }

    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 25px;
        margin-top: 25px;
    }

    .card-description {
        color: #666;
        line-height: 1.6;
        margin-bottom: 15px;
        font-size: 15px;
    }

    .card-features {
        list-style: none;
        padding: 0;
        margin-bottom: 20px;
    }

    .card-features li {
        padding: 8px 0;
        color: #555;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .card-features li:before {
        content: "\2713";
        color: #28a745;
        font-weight: bold;
    }

    .card-actions {
        display: flex;
        gap: 10px;
        margin-top: auto;
    }

    .home-footer {
        text-align: center;
        padding: 30px;
        color: white;
        font-size: 14px;
        opacity: 0.9;
    }

    .footer-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 15px;
        flex-wrap: wrap;
    }

    .footer-links a {
        color: white;
        text-decoration: none;
        opacity: 0.8;
    }

    .footer-links a:hover {
        opacity: 1;
        text-decoration: underline;
    }

    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.6);
        animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    .modal-content {
        background-color: white;
        margin: 5% auto;
        padding: 30px;
        border-radius: 15px;
        width: 90%;
        max-width: 700px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        position: relative;
        animation: slideIn 0.3s ease;
    }

    @keyframes slideIn {
        from { transform: translateY(-50px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    .close {
        color: #aaa;
        position: absolute;
        top: 15px;
        right: 20px;
        font-size: 30px;
        font-weight: bold;
        cursor: pointer;
        transition: color 0.3s;
    }

    .close:hover { color: #333; }

    .modal-section { margin-bottom: 25px; }

    .modal-section h3 {
        color: #b74420;
        margin-bottom: 12px;
        font-size: 18px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .modal-section p {
        color: #555;
        line-height: 1.7;
        margin-bottom: 10px;
    }

    .modal-section ul { list-style: none; padding: 0; }

    .modal-section li {
        padding: 8px 0;
        color: #555;
        line-height: 1.6;
        border-bottom: 1px solid #f0f0f0;
    }

    .modal-section li:last-child { border-bottom: none; }

    .modal-section a { color: #b74420; text-decoration: none; }
    .modal-section a:hover { text-decoration: underline; }

    .category-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .category-user { background: #d4edda; color: #155724; }
    .category-admin { background: #fff3cd; color: #856404; }

    .info-badge {
        background: #e7f3ff;
        color: #004085;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
        margin-left: 8px;
    }

    @media (max-width: 768px) {
        .home-header h1 { font-size: 32px; }
        .home-header p { font-size: 16px; }
        .home-nav ul { gap: 15px; }
        .home-nav li a { padding: 8px 15px; font-size: 14px; }
        .cards-grid { grid-template-columns: 1fr; }
        .modal-content { width: 95%; margin: 10% auto; padding: 20px; }
    }

    @media (max-width: 480px) {
        .card-actions { flex-direction: column; }
        .home-nav ul { flex-direction: column; align-items: center; gap: 10px; }
    }
</style>
{% endblock %}

{% block body %}
<div class="main_container">
    <div class="container">
        {{ header(
            title='LLMAgents - Portail M3C',
            subtitle='Système RAG pour l\'analyse documentaire et la recherche intelligente',
            title_icon='🏠',
            page='/',
            show_admin=false
        ) }}

        {# --- Description du projet --- #}
        {% call section(id='accueil', title='À propos du projet LLMAgents', title_icon='📚') %}
            <div class="project-description">
                <p>Bienvenue sur le site prototype de développement d'outils basés sur IA générative pour la M3C.</p>
                <p><strong>Objectif principal:</strong> Faciliter l'accès aux connaissances contenues dans les documents
                en permettant une recherche sémantique et vectorielle avancée et une interaction naturelle avec les données.</p>
                <div class="technologies">
                    <span class="tech-tag">FastAPI</span>
                    <span class="tech-tag">Mistral AI</span>
                    <span class="tech-tag">ChromaDB</span>
                    <span class="tech-tag">Qdrant</span>
                    <span class="tech-tag">Solr</span>
                    <span class="tech-tag">RAG</span>
                    <span class="tech-tag">LLM</span>
                </div>
            </div>
        {% endcall %}

        {# --- Interfaces utilisateur --- #}
        {% call section(id='interfaces', title='Interfaces Utilisateur',
                        title_icon='📱',
                        extra='<span class="info-badge">6 interfaces disponibles</span>') %}
            <div class="cards-grid">
                {{ feature_card(
                    title='Chatbot RAG',
                    description="Interface principale de discussion avec le modèle LLM. Posez des questions en langage naturel et obtenez des réponses basées sur les documents indexés avec sources citées.",
                    href='/m3c-chatbot',
                    icon='🤖',
                    category='user',
                    modal_id='chatbot-info'
                ) }}

                {{ feature_card(
                    title='PDF + Chat',
                    description="Interface permettant de sélectionner un document PDF et d'interagir avec son contenu via un chat intelligent. Visualisation du PDF intégrée.",
                    href='/question-session',
                    icon='📄',
                    category='user',
                    features=['Sélection de documents PDF','Visualisation du PDF','Chat contextuel par document','Navigation facile','Recherche ciblée'],
                    modal_id='pdf-chat-info'
                ) }}

                {{ feature_card(
                    title='Recherche Solr',
                    description="Interface de recherche sémantique avancée utilisant Apache Solr pour trouver des informations précises dans le corpus documentaire.",
                    href='/solr-search',
                    icon='🔍',
                    category='user',
                    features=['Recherche full-text','Filtrage avancé','Résultats pertinents','Visualisation des résultats','Export possible'],
                    modal_id='solr-info'
                ) }}

                {{ feature_card(
                    title='Visualisation RAG',
                    description="Visualisation interactive des embeddings en 2D utilisant les algorithmes t-SNE ou UMAP. Explorez les relations entre les chunks de documents.",
                    href='/rag-visualization',
                    icon='📊',
                    category='user',
                    features=['Projection t-SNE','Projection UMAP','Visualisation interactive','Coloration par document','Exploration des clusters'],
                    modal_id='visualization-info'
                ) }}

                {{ feature_card(
                    title='Gestion Q/R',
                    description="Interface de gestion des questions et réponses. Créez, modifiez et organisez les questions pour faciliter la recherche et l'apprentissage.",
                    href='/questions-management',
                    icon='🎯',
                    category='user',
                    features=['Création de questions','Organisation par catégories','Suivi des réponses','Évaluation des réponses','Export des données'],
                    modal_id='qr-info'
                ) }}
            </div>
        {% endcall %}

        {# --- Footer --- #}
        <div class="home-footer">
            <p><strong>LLMAgents © 2026</strong> - M3C (Maison des Sciences de l'Homme Mondes Contemporains)</p>
            <p>Système RAG pour l'analyse documentaire intelligente</p>
            <div class="footer-links">
                <a href="#accueil">Accueil</a>
                <a href="#interfaces">Interfaces</a>
                <a href="#admin">Administration</a>
                <a href="/m3c-chatbot">Chatbot</a>
            </div>
            <p style="margin-top: 15px; font-size: 12px;">Version 0.1.0 | FastAPI | Mistral AI | RAG Technology</p>
        </div>
    </div>
</div>

{# --- Modales d'information --- #}
<div id="chatbot-info" class="modal"><div class="modal-content"><span class="close" onclick="hideModal('chatbot-info')">&times;</span>
    <h2>🤖 Chatbot RAG - Interface Standard</h2>
    <div class="modal-section"><h3>📋 Description</h3><p>Interface principale permettant de poser des questions au système RAG. Le modèle utilise les documents indexés pour générer des réponses précises et sourcées.</p></div>
    <div class="modal-section"><h3>⚙️ Fonctionnalités clés</h3><ul>
        <li><strong>RAG activable:</strong> Choisissez d'utiliser ou non la recherche de documents</li>
        <li><strong>Reranking:</strong> Améliore la pertinence des sources trouvées</li>
        <li><strong>Multi-modèles:</strong> Sélection de plusieurs modèles LLM (Mistral, etc.)</li>
        <li><strong>Nombre de sources:</strong> Contrôle du nombre de documents utilisés (1-20)</li>
        <li><strong>Historique:</strong> Accès à l'historique complet des échanges</li>
        <li><strong>Visualisation:</strong> Affichage des sources citées avec leurs scores</li>
    </ul></div>
    <div class="modal-section"><h3>🎯 Cas d'usage</h3><ul>
        <li>Poser des questions spécifiques sur les documents M3C</li>
        <li>Obtenir des réponses avec sources citées</li>
        <li>Comparer les réponses de différents modèles</li>
        <li>Explorer le corpus documentaire de manière interactive</li>
        <li>Trouver des informations précises rapidement</li>
    </ul></div>
    <div class="modal-section"><h3>🔗 Accès rapide</h3><p><a href="/m3c-chatbot" class="btn btn-primary">Ouvrir l'interface</a></p></div>
</div></div>

<div id="pdf-chat-info" class="modal"><div class="modal-content"><span class="close" onclick="hideModal('pdf-chat-info')">&times;</span>
    <h2>📄 PDF + Chat - Interface Documentaire</h2>
    <div class="modal-section"><h3>📋 Description</h3><p>Interface permettant de travailler avec des documents PDF spécifiques. Sélectionnez un document et discutez de son contenu avec le chatbot.</p></div>
    <div class="modal-section"><h3>⚙️ Fonctionnalités clés</h3><ul>
        <li><strong>Sélection de PDF:</strong> Parcourez et sélectionnez parmi les documents disponibles</li>
        <li><strong>Visualisation intégrée:</strong> Aperçu du PDF directement dans l'interface</li>
        <li><strong>Chat contextuel:</strong> Discussion spécifique au document sélectionné</li>
        <li><strong>Navigation facile:</strong> Changement rapide entre documents</li>
        <li><strong>Recherche ciblée:</strong> Posez des questions sur un document spécifique</li>
    </ul></div>
    <div class="modal-section"><h3>🎯 Cas d'usage</h3><ul>
        <li>Analyser un document PDF spécifique</li>
        <li>Extraire des informations d'un document</li>
        <li>Poser des questions sur le contenu d'un PDF</li>
        <li>Comparer différents documents</li>
        <li>Étudier un document en détail</li>
    </ul></div>
    <div class="modal-section"><h3>🔗 Accès rapide</h3><p><a href="/question-session" class="btn btn-primary">Ouvrir l'interface</a></p></div>
</div></div>

<div id="solr-info" class="modal"><div class="modal-content"><span class="close" onclick="hideModal('solr-info')">&times;</span>
    <h2>🔍 Recherche Solr - Moteur de recherche sémantique</h2>
    <div class="modal-section"><h3>📋 Description</h3><p>Interface de recherche avancée utilisant Apache Solr pour effectuer des recherches sémantiques et full-text dans le corpus documentaire.</p></div>
    <div class="modal-section"><h3>⚙️ Fonctionnalités clés</h3><ul>
        <li><strong>Recherche full-text:</strong> Recherche dans tout le contenu des documents</li>
        <li><strong>Filtrage avancé:</strong> Appliquez des filtres pour affiner les résultats</li>
        <li><strong>Recherche sémantique:</strong> Compréhension du contexte et de l'intention</li>
        <li><strong>Résultats pertinents:</strong> Classés par pertinence et score</li>
        <li><strong>Visualisation:</strong> Affichage clair des résultats avec extraits</li>
        <li><strong>Export:</strong> Possibilité d'exporter les résultats de recherche</li>
    </ul></div>
    <div class="modal-section"><h3>🎯 Cas d'usage</h3><ul>
        <li>Trouver des documents sur un sujet spécifique</li>
        <li>Rechercher des informations précises dans le corpus</li>
        <li>Explorer les relations entre les documents</li>
        <li>Effectuer des recherches complexes avec filtres</li>
    </ul></div>
    <div class="modal-section"><h3>🔗 Accès rapide</h3><p><a href="/solr-search" class="btn btn-primary">Ouvrir l'interface</a></p></div>
</div></div>

<div id="visualization-info" class="modal"><div class="modal-content"><span class="close" onclick="hideModal('visualization-info')">&times;</span>
    <h2>📊 Visualisation RAG - Analyse des embeddings</h2>
    <div class="modal-section"><h3>📋 Description</h3><p>Visualisation interactive en 2D des embeddings générés par le système RAG. Utilisez t-SNE ou UMAP pour explorer les relations entre les chunks de documents.</p></div>
    <div class="modal-section"><h3>⚙️ Fonctionnalités clés</h3><ul>
        <li><strong>Projection t-SNE:</strong> Algorithme de réduction de dimension pour la visualisation</li>
        <li><strong>Projection UMAP:</strong> Alternative à t-SNE avec des avantages différents</li>
        <li><strong>Visualisation interactive:</strong> Zoom, panoramique, sélection</li>
        <li><strong>Coloration par document:</strong> Identification visuelle des documents</li>
        <li><strong>Exploration des clusters:</strong> Découverte de groupes de chunks similaires</li>
        <li><strong>Limitation du nombre:</strong> Contrôle du nombre de chunks affichés</li>
    </ul></div>
    <div class="modal-section"><h3>🎯 Cas d'usage</h3><ul>
        <li>Comprendre les relations entre les documents</li>
        <li>Identifier des clusters thématiques</li>
        <li>Visualiser la structure du corpus</li>
        <li>Analyser la distribution des embeddings</li>
        <li>Explorer les similarités entre chunks</li>
    </ul></div>
    <div class="modal-section"><h3>🔗 Accès rapide</h3><p><a href="/rag-visualization" class="btn btn-primary">Ouvrir l'interface</a></p></div>
</div></div>

<div id="qr-info" class="modal"><div class="modal-content"><span class="close" onclick="hideModal('qr-info')">&times;</span>
    <h2>🎯 Gestion des Questions/Réponses</h2>
    <div class="modal-section"><h3>📋 Description</h3><p>Interface de gestion complète des questions et réponses. Créez, organisez et évaluez les questions pour faciliter la recherche et l'apprentissage.</p></div>
    <div class="modal-section"><h3>⚙️ Fonctionnalités clés</h3><ul>
        <li><strong>Création de questions:</strong> Ajoutez de nouvelles questions au système</li>
        <li><strong>Organisation par catégories:</strong> Classez les questions par thèmes</li>
        <li><strong>Suivi des réponses:</strong> Gestion des réponses aux questions</li>
        <li><strong>Évaluation:</strong> Notation et feedback sur les réponses</li>
        <li><strong>Export des données:</strong> Export en CSV ou JSON</li>
        <li><strong>Recherche:</strong> Trouvez rapidement des questions spécifiques</li>
    </ul></div>
    <div class="modal-section"><h3>🎯 Cas d'usage</h3><ul>
        <li>Créer des quiz ou évaluations</li>
        <li>Organiser des questions par thème</li>
        <li>Suivre les progrès d'apprentissage</li>
        <li>Évaluer la qualité des réponses</li>
        <li>Exporter les données pour analyse</li>
    </ul></div>
    <div class="modal-section"><h3>🔗 Accès rapide</h3><p><a href="/questions-management" class="btn btn-primary">Ouvrir l'interface</a></p></div>
</div></div>
{% endblock %}

{% block scripts %}
<script>
    function showModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) { modal.style.display = "block"; document.body.style.overflow = "hidden"; }
    }
    function hideModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) { modal.style.display = "none"; document.body.style.overflow = "auto"; }
    }
    window.onclick = function(event) {
        const modals = document.getElementsByClassName("modal");
        for (let modal of modals) {
            if (event.target === modal) { modal.style.display = "none"; document.body.style.overflow = "auto"; }
        }
    }
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) { target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
        });
    });
    const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -50px 0px' };
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
            }
        });
    }, observerOptions);
    document.querySelectorAll('.section').forEach(section => {
        section.style.opacity = '0';
        section.style.transform = 'translateY(20px)';
        section.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
        observer.observe(section);
    });
</script>
{% endblock %}
