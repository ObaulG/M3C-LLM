# =============================================================================
# Configuration Docker pour LLMAgents
# Ce fichier contient les variables d'environnement spécifiques à Docker
# Copiez ce fichier en .env pour l'utiliser : cp .env.docker .env
# =============================================================================

# --- Configuration de la base de données MySQL ---
# Dans Docker, utilisez les noms de service comme host
DB_HOST=mysql
DB_PORT=3306
DB_NAME=m3c_database
DB_USER=OBL
DB_PASSWORD=azerty

# --- Configuration de Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Configuration de l'API FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Configuration pour éviter les problèmes Windows/Linux ---
# Désactive la politique d'event loop Windows spécifique
PYTHONASYNCIODEBUG=0

# --- Variables de développement (optionnel) ---
# Pour activer le mode développement (reload automatique)
# RELOAD=true

# --- Clés API (à configurer selon vos besoins) ---
# MISTRAL_API_KEY=votre_clé_api_mistral
# OPENAI_API_KEY=votre_clé_api_openai
# GOOGLE_API_KEY=votre_clé_api_google

# =============================================================================
# Notes:
# - En production Docker, utilisez les noms de service Docker comme host
#   (mysql pour MySQL, qdrant pour Qdrant)
# - Pour un développement local sans Docker, utilisez localhost
# - Les valeurs par défaut correspondent à la configuration Docker
# - Copiez ce fichier en .env pour l'utiliser
# =============================================================================