# =============================================================================
# Configuration pour l'application LLMAgents
# =============================================================================

# --- Configuration de la base de données MySQL ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=m3c_database
DB_USER=OBL
DB_PASSWORD=azerty

# --- Configuration de Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Configuration de l'API FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
REQUIRE_USER_MISTRAL_API_KEY=false

# --- Sauvegarde locale (MySQL + Qdrant) ---
# Sauvegarde des tables MySQL du projet et des collections Qdrant exécutée
# à l'arrêt du serveur et/ou périodiquement (app/database/local_backup.py)
LOCAL_BACKUP_ON_SHUTDOWN=true
LOCAL_BACKUP_INTERVAL_SECONDS=0
LOCAL_BACKUP_RETENTION_DAYS=30
LOCAL_BACKUP_DIR=backups

# LLM API keys
MISTRAL_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""

